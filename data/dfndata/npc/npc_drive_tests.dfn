// Optional NPC drive-system test actors.
// These sections are never spawned by stock regions or menus. Add them manually:
//   'add npc npc_drive_test_leader
//   'add npc npc_drive_test_member
//   'add npc npc_drive_test_scared
//   'add npc npc_drive_test_intruder

[npc_drive_test_leader]
{
GET=greywolf
NAME=NPC drive test pack leader
NPCWANDER=0
WILLHUNGER=1
CUSTOMSTRINGTAG=NpcDriveProfile animal
CUSTOMSTRINGTAG=NpcDrivePackId drive_test_pack
CUSTOMSTRINGTAG=NpcDrivePackRole leader
CUSTOMINTTAG=NpcDrivePackRadius 12
CUSTOMINTTAG=NpcDrivePackFollowDistance 4
CUSTOMSTRINGTAG=NpcDriveTerritoryTargets drive_intruder
CUSTOMSTRINGTAG=NpcDriveHoardResources gold,gem
CUSTOMINTTAG=NpcDriveTerritoryRadius 8
CUSTOMINTTAG=NpcDriveHoardGuardRadius 4
CUSTOMSTRINGTAG=NpcDriveDesires gold:pickup:15,honey:nearby:15
CUSTOMSTRINGTAG=NpcDriveReturnResources gold
CUSTOMINTTAG=NpcDriveDesireSearchRadius 12
CUSTOMSTRINGTAG=NpcDriveIdleActivities home,roam,pause
CUSTOMINTTAG=NpcDriveBoredomDelay 10
CUSTOMINTTAG=NpcDriveIdleDuration 5
CUSTOMINTTAG=NpcDriveIdleRadius 6
CUSTOMINTTAG=NpcDriveLeashRadius 16
}

