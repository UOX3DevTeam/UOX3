// Shadow Armor Bonus for AoS ruleset - applied on top of existing stats
[shadow_armor_bonus_aos]
{
defbonus=2
erbonus=1 0 0 5
hpbonus=100
}

// Shadow Armor Bonus for ToL ruleset - applied on top of existing stats
[shadow_armor_bonus_tol]
{
defbonus=3
erbonus=2 0 0 7
hpbonus=100
}

