// Veteran reward items used by vet_rewards_table.json
// Uses existing vet reward tooltip script 5303.

[vet_black_dye_tub]
{
GET=base_item
NAME=black dye tub
ID=0x0FAB
WEIGHT=10
MOVABLE=1
COLOR=1
SCRIPT=5303//vet reward tooltips
SCRIPT=7607//vet reward dye tub
custominttag=vetRewardYear 1
customstringtag=dyeTubType dyable
custominttag=dyeTubHue 1
custominttag=dyeTubRedyable 0
}

