// ============================================================================
// Power Scrolls (Scrolls of Power) - DFN
// Base + all skills you listed, for bonuses: +5, +10, +15, +20
// Requires JS script 7504 (power_scrolls.js) that reads:
//   customstringtag=powerSkill <skillProp>
//   custominttag=powerBonus <5|10|15|20>
// ============================================================================

[base_powerscroll]
{
get=base_item
name=Scroll of Power
id=0x14F0
colour=0x481
weight=100
pileable=0
amount=1
decay=1
script=7504
origin=aos
customstringtag=powerSkill allskills
custominttag=powerBonus 0
}

// --------------------------------------------------------------------------
// Swordsmanship
// --------------------------------------------------------------------------

[powerscroll_swordsmanship_5]
{
get=base_powerscroll
name=wonderous scroll of Swordsmanship
customstringtag=powerSkill swordsmanship
custominttag=powerBonus 5
}

