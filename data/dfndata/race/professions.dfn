// Crafting and gathering professions used when LEVELSYSTEMENABLED and LEVELSYSTEMCRAFTING are enabled.
// Values use UOX3's tenths-based skill scale: 1000 is displayed as 100.0.
// EXPERIENCEPERPOINT is the profession XP needed for one 0.1 proficiency increase.
// PRIMARY=1 consumes a primary profession slot; PRIMARY=0 is a free secondary profession.

[PROFESSION 1]
{
NAME=Blacksmithing
DESCRIPTION=Forge weapons, armor, shields, and metal tools from ingots.
TYPE=CRAFTING
PRIMARY=1
SKILL=BLACKSMITHING
STARTVALUE=0
MAXVALUE=1000
EXPERIENCEPERPOINT=100
}

[PROFESSION 2]
{
NAME=Tailoring
DESCRIPTION=Create clothing and armor from cloth, hides, and leather.
