//=============================================================================
// Default class abilities
//=============================================================================

[CLASS ABILITY 1001]
{
NAME=Second Wind
DESCRIPTION=Recover 25 health by drawing on your remaining stamina.
LEVEL=1
ACTION=RESTOREHEALTH
VALUE=25
STAMINACOST=10
COOLDOWN=45
}

[CLASS ABILITY 1002]
{
NAME=Rally
DESCRIPTION=Recover 40 stamina and return to the fight.
LEVEL=10
ACTION=RESTORESTAMINA
VALUE=40
COOLDOWN=60
}

[CLASS ABILITY 2001]
{
NAME=Arcane Recovery
DESCRIPTION=Focus inward to recover 30 mana.
