//=============================================================================
// UOX3 level-system class definitions
//
// Class ids must start at 1 and remain contiguous. Characters persist this id.
// Skill names must match NAME entries in dfndata/skills/skills.dfn.
// Skill values use UOX3 tenths (300 = 30.0). Cap values are percentages of the
// shard's SKILLCAPSINGLE setting.
//
// Optional equipment restrictions use ALLOWEQUIPLIST or BANEQUIPLIST and a
// [CLASS EQUIPLIST #] section containing comma-separated item graphic ids.
// If an allow list is present, every unlisted item is rejected for that class.
//
// ABILITY references a [CLASS ABILITY #] section. Supported built-in ACTIONs
// are RESTOREHEALTH, RESTOREMANA, RESTORESTAMINA, SPELL and PASSIVE. SCRIPT
// dispatches to SCRIPT/FUNCTION and passes the character, ability id and VALUE.
//=============================================================================

[CLASS 1]
{
NAME=Warrior
DESCRIPTION=Durable melee fighter with strong weapons, tactics and parrying.
HEALTHPERLEVEL=2
MANAPERLEVEL=0
STAMINAPERLEVEL=1
PRIMARYSKILLS=SWORDSMANSHIP,MACEFIGHTING,FENCING,TACTICS,PARRYING
CORESKILLS=ANATOMY,HEALING,MAGICRESISTANCE,CHIVALRY,BUSHIDO,WRESTLING
SUPPORTSKILLS=ARMSLORE,FOCUS
PRIMARYSTART=300
PRIMARYCAP=100
CORESTART=200
CORECAP=85
SUPPORTSTART=100
SUPPORTCAP=60
OTHERSTART=0
OTHERCAP=25
ABILITY=1001
ABILITY=1002
}

