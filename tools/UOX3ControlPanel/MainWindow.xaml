<Window x:Class="UOX3ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UOX3 Control Panel" Width="1120" Height="760" MinWidth="860" MinHeight="580"
        Background="#101720" Foreground="#E8EDF2" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="18,14" BorderBrush="#304056" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="UOX3 CONTROL PANEL" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#708090" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Stopped" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Margin="14" Background="{StaticResource PanelBrush}" BorderBrush="#304056">
            <TabItem Header="Dashboard">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button x:Name="StartButton" Content="▶  Start server" Background="#276749" Click="Start_Click" />
                        <Button x:Name="ShutdownButton" Content="■  Graceful shutdown" Click="Shutdown_Click" IsEnabled="False" />
                        <Button x:Name="RestartButton" Content="↻  Restart" Click="Restart_Click" IsEnabled="False" />
                        <Button x:Name="ForceStopButton" Content="Force stop" Background="#7A3030" Click="ForceStop_Click" IsEnabled="False" />
                        <Button Content="Choose uox3.exe…" Click="ChooseExecutable_Click" />
                        <Button Content="Open server folder" Click="OpenServerFolder_Click" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,6,0,6">
                        <TextBlock Text="Reload:" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="#9DB0C5" />
                        <Button Content="INI" Tag="1" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="Accounts" Tag="2" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="Regions" Tag="3" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="Spawns" Tag="4" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="Spells" Tag="5" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="Commands" Tag="6" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="Definitions" Tag="7" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="JavaScript" Tag="8" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        <Button Content="HTML" Tag="9" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="SHARD" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="ShardNameText" Text="—" Foreground="White" FontSize="16" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Margin="2,0,4,0">
                            <StackPanel><TextBlock Text="ADDRESS" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="AddressText" Text="—" Foreground="White" FontSize="16" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Margin="4,0,2,0">
                            <StackPanel><TextBlock Text="UPTIME" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="UptimeText" Text="—" Foreground="White" FontSize="16"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Margin="6,0,0,0">
                            <StackPanel><TextBlock Text="PROCESS" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="ProcessText" Text="Not running" Foreground="White" FontSize="16"/></StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="3">
                        <WrapPanel>
                            <TextBlock Text="Actions:" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="#9DB0C5" />
                            <Button Content="Save world" Tag="@" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <Button Content="Save accounts" Tag="!" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <Button Content="Players online" Tag="W" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <Button Content="Performance" Tag="P" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <Button Content="Memory" Tag="M" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <Button Content="Server settings" Tag="C" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <Button Content="Command help" Tag="?" Click="SendKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Broadcast:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9DB0C5"/>
                            <TextBox Grid.Column="1" x:Name="BroadcastText" Padding="8,6" KeyDown="BroadcastText_KeyDown" />
                            <Button Grid.Column="2" Content="Send" Margin="8,0,18,0" Click="Broadcast_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                            <TextBox Grid.Column="3" x:Name="CustomKeyText" MaxLength="1" Padding="8,6" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="4" Content="Send key" Margin="8,0,0,0" Click="CustomKey_Click" IsEnabled="{Binding IsEnabled, ElementName=ShutdownButton}" />
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="4" BorderBrush="#304056" BorderThickness="1" Background="#080D13">
                        <Grid>
                            <RichTextBox x:Name="ConsoleText" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         BorderThickness="0" Padding="10" Background="#080D13" Foreground="#C8D0D8" />
                            <Button Content="Clear" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="10,4"
                                    Opacity="0.75" Click="ClearConsole_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Configuration">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button Content="Reload from disk" DockPanel.Dock="Left" Click="LoadConfig_Click" />
                        <Button Content="Save with backup" DockPanel.Dock="Left" Background="#276749" Click="SaveConfig_Click" />
                        <TextBlock x:Name="ConfigStatusText" VerticalAlignment="Center" Margin="8,0" Foreground="#9DB0C5" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="420" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MinWidth="285" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ConfigText" FontFamily="Cascadia Mono,Consolas" FontSize="13"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" TextChanged="ConfigText_TextChanged"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10" />
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#304056" />
                        <Border Grid.Column="2" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="INI SETTINGS GUIDE" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBox Grid.Row="1" x:Name="IniSearchText" Margin="0,10,0,8" Padding="8,6" TextChanged="IniSearch_TextChanged"
                                         ToolTip="Search setting names, sections, and descriptions" />
                                <ListBox Grid.Row="2" x:Name="IniSettingList" Background="#0D141D" Foreground="White" BorderBrush="#304056"
                                         SelectionChanged="IniSettingList_SelectionChanged"/>
                                <TextBlock Grid.Row="3" x:Name="IniNameText" Margin="0,12,0,2" FontFamily="Cascadia Mono,Consolas" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="4" x:Name="IniSectionText" Foreground="#8FA6BD"/>
                                <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="#8FA6BD"><Run Text="Current: "/><Run x:Name="IniCurrentValueText" Foreground="White"/></TextBlock>
                                <TextBlock Grid.Row="6" Foreground="#8FA6BD"><Run Text="Default: "/><Run x:Name="IniDefaultValueText" Foreground="White"/></TextBlock>
                                <TextBlock Grid.Row="7" x:Name="IniDescriptionText" Margin="0,10,0,8" Foreground="#C7D3DF" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="8">
                                    <TextBlock x:Name="IniApplyText" Foreground="#D5A84B" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Button Content="Jump to setting" HorizontalAlignment="Left" Click="JumpToIniSetting_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.ColumnSpan="3">
                        <Button Content="Refresh" Click="RefreshLogs_Click" />
                        <Button Content="Open logs folder" Click="OpenLogsFolder_Click" />
                    </WrapPanel>
                    <ListBox Grid.Row="1" Grid.Column="0" x:Name="LogList" Background="#0D141D" Foreground="#DDE6EF"
                             BorderBrush="#40536B" SelectionChanged="LogList_SelectionChanged" />
                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#304056" />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="LogText" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10" />
                </Grid>
            </TabItem>

            <TabItem Header="Network Setup">
                <Grid Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="NETWORK STATUS" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Configured TCP port" Foreground="#AFC1D4" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NetworkPortText" Text="—" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="LAN address" Foreground="#AFC1D4" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LanAddressText" Text="—" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Server listener" Foreground="#AFC1D4" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ListenerStatusText" Text="Not checked" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="Windows Firewall" Foreground="#AFC1D4" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FirewallStatusText" Text="Not checked" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,16,0,8">
                        <Button Content="Refresh status" Click="RefreshNetwork_Click" />
                        <Button Content="Allow through firewall" Background="#276749" Click="AddFirewallRule_Click" />
                        <Button Content="Remove firewall rule" Background="#7A3030" Click="RemoveFirewallRule_Click" />
                    </WrapPanel>
                    <Border Grid.Row="3" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="14" Margin="0,8,0,12">
                        <StackPanel>
                            <TextBlock Text="ROUTER PORT FORWARDING" Foreground="#AFC1D4" FontWeight="SemiBold" />
                            <TextBlock x:Name="RouterInstructionsText" Margin="0,8,0,0" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Foreground="#9DB0C5" TextWrapping="Wrap"
                                       Text="Router configuration is separate from Windows Firewall. Reserve the server computer's LAN address in your router, then forward the external TCP port to the same internal TCP port." />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="4" Foreground="#D5A84B" TextWrapping="Wrap"
                               Text="Security: only expose the UOX3 game port. Do not forward file sharing, remote desktop, database, or control-panel ports." />
                </Grid>
            </TabItem>

            <TabItem Header="Security Audit">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Border Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Width="185" Margin="0,0,8,0"><StackPanel><TextBlock Text="PASSWORD HASHING" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="HashingAuditText" Text="—" Foreground="White" FontSize="15"/></StackPanel></Border>
                        <Border Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Width="185" Margin="0,0,8,0"><StackPanel><TextBlock Text="ACCOUNT CREATION" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="CreationAuditText" Text="—" Foreground="White" FontSize="15"/></StackPanel></Border>
                        <Border Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Width="185" Margin="0,0,8,0"><StackPanel><TextBlock Text="LOGIN THROTTLE" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="ThrottleAuditText" Text="—" Foreground="White" FontSize="15"/></StackPanel></Border>
                        <Border Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Width="185" Margin="0,0,8,0"><StackPanel><TextBlock Text="BACKUPS" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="BackupAuditText" Text="—" Foreground="White" FontSize="15"/></StackPanel></Border>
                        <Border Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Width="185"><StackPanel><TextBlock Text="FIREWALL EXPOSURE" Foreground="#AFC1D4" FontSize="11"/><TextBlock x:Name="FirewallAuditText" Text="—" Foreground="White" FontSize="15"/></StackPanel></Border>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="Refresh audit" Click="RefreshSecurity_Click" />
                    </WrapPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Accounts" Foreground="#E8EDF2" BorderBrush="#304056" Padding="8">
                            <ListBox x:Name="SecurityAccountList" Background="#0D141D" Foreground="White" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusLabel}" FontFamily="Cascadia Mono,Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding LastIp, StringFormat=Last IP: {0}}" FontFamily="Cascadia Mono,Consolas" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="{Binding ActionLabel}" Click="AccountBanToggle_Click" Padding="10,4" Margin="4,1" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#304056" />
                        <GroupBox Grid.Column="2" Header="Recent failed-login IPs" Foreground="#E8EDF2" BorderBrush="#304056" Padding="8">
                            <ListBox x:Name="FailedLoginList" Background="#0D141D" Foreground="White" BorderThickness="0" FontFamily="Cascadia Mono,Consolas" />
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Updates">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="Official channel:" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AFC1D4"/>
                        <ComboBox x:Name="UpdateChannelCombo" Width="170" SelectedIndex="0" Margin="0,0,8,8">
                            <ComboBoxItem Content="Stable (master)" Tag="master"/>
                            <ComboBoxItem Content="Development" Tag="develop"/>
                        </ComboBox>
                        <Button Content="Check for updates" Click="CheckUpdates_Click"/>
                        <Button x:Name="InstallDataUpdatesButton" Content="Install safe JS/DFN updates" Background="#276749" Click="InstallDataUpdates_Click" IsEnabled="False"/>
                        <Button x:Name="InstallFullUpdateButton" Content="Build and install full update" Background="#8A6325" Click="InstallFullUpdate_Click" IsEnabled="False"/>
                        <Button x:Name="MergeUpdateButton" Content="Merge selected conflict" Click="MergeUpdate_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="#101923" BorderBrush="#304056" BorderThickness="1" Padding="12" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock x:Name="UpdateSummaryText" Text="No update check has been run." Foreground="White" TextWrapping="Wrap"/>
                            <Grid x:Name="BuildProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ProgressBar x:Name="BuildProgressBar" Height="9" IsIndeterminate="True" Foreground="#D5A84B"/>
                                <DockPanel Grid.Row="1" Margin="0,7,0,0">
                                    <TextBlock x:Name="BuildElapsedText" DockPanel.Dock="Right" Foreground="#8FA6BD" Margin="12,0,0,0"/>
                                    <TextBlock x:Name="BuildDetailText" Foreground="#AFC1D4" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="UpdateList" Background="#0D141D" Foreground="White" BorderBrush="#304056" FontFamily="Cascadia Mono,Consolas" SelectionChanged="UpdateList_SelectionChanged"/>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#D5A84B" TextWrapping="Wrap"
                               Text="Only conflict-free JavaScript and DFN files are installed automatically. Core changes require a reviewed build; local conflicts are never overwritten."/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#182231" Padding="12,7" BorderBrush="#304056" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Text="Ready" Foreground="#9DB0C5" />
        </Border>
    </Grid>
</Window>
