<Window x:Class="UOX3ControlPanel.MergeReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review update merge" Width="1100" Height="760" MinWidth="800" MinHeight="520"
        Background="#101720" Foreground="#E8EDF2" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TabControl Grid.Row="1" Background="#182231" BorderBrush="#304056">
            <TabItem Header="Merged result"><TextBox x:Name="MergedText" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono,Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#080D13" Foreground="White"/></TabItem>
            <TabItem Header="Your local file"><TextBox x:Name="LocalText" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#080D13" Foreground="White"/></TabItem>
            <TabItem Header="Original base"><TextBox x:Name="BaseText" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#080D13" Foreground="White"/></TabItem>
            <TabItem Header="New upstream"><TextBox x:Name="UpstreamText" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#080D13" Foreground="White"/></TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#D5A84B" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Apply merged file" Background="#276749" Click="Apply_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
